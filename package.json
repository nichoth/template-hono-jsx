{
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "main": "dist/index.js",
  "files": [
    "./dist/*"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "import": [
        "./dist/*.js",
        "./dist/*"
      ],
      "require": [
        "./dist/*.cjs",
        "./dist/*"
      ]
    }
  },
  "scripts": {
    "lint": "eslint \"./**/*.{ts,tsx,js}\"",
    "test": "npm run test:ssr && npm run test:client",
    "test:ssr": "esbuild ./test/index.ts --bundle --platform=node --format=esm --loader:.css=text --log-level=error --alias:cloudflare:workers=./test/stubs/cloudflare-workers.ts --define:import.meta.env.DEV=true --define:import.meta.env.MODE='\"development\"' | node --input-type=module | tap-spec",
    "test:client": "esbuild ./test/client.ts --bundle --packages=external --platform=node --format=esm --loader:.css=text --log-level=error --alias:cloudflare:workers=./test/stubs/cloudflare-workers.ts --define:import.meta.env.DEV=false --define:import.meta.env.MODE='\"test\"' | node --input-type=module | tap-spec",
    "test:hydration": "esbuild ./test/hydration.ts --bundle --packages=external --platform=node --format=esm --loader:.css=text --log-level=error | node --input-type=module | tap-spec",
    "build-cjs": "esbuild src/*.ts --format=cjs --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --out-extension:.js=.cjs --sourcemap",
    "build-cjs:min": "esbuild src/*.ts --format=cjs --minify --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --out-extension:.js=.min.cjs --sourcemap",
    "build-esm": "esbuild src/*.ts --format=esm --metafile=dist/meta.json --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --sourcemap && tsc --emitDeclarationOnly --project tsconfig.build.json --outDir dist",
    "build-esm:min": "esbuild ./src/*.ts --format=esm --keep-names --bundle --tsconfig=tsconfig.build.json --minify --out-extension:.js=.min.js --outdir=./dist --sourcemap",
    "build-example": "mkdir -p ./public && rm -rf ./public/* && VITE_DEBUG_MODE=staging vite --mode staging --base=\"/repo-name\" build",
    "build-docs": "typedoc ./src/index.ts",
    "build": "mkdir -p ./dist && rm -rf ./dist/* && npm run build-cjs && npm run build-esm && npm run build-esm:min && npm run build-cjs:min",
    "start": "vite dev",
    "toc": "markdown-toc --maxdepth 3 -i README.md",
    "preversion": "npm run lint",
    "version": "npm run toc && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && git add CHANGELOG.md README.md",
    "postversion": "git push --follow-tags && npm publish",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.2",
    "@substrate-system/css-normalize": "^0.0.13",
    "@substrate-system/routes": "^5.0.5",
    "hono": "^4.11.3",
    "hono-sessions": "^0.8.0",
    "honox": "^0.1.53",
    "route-event": "^7.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.17.1",
    "@cloudflare/workers-types": "^4.20260111.0",
    "@substrate-system/debug": "^0.9.24",
    "@substrate-system/tapout": "^0.0.33",
    "@substrate-system/tapzero": "^0.10.15",
    "@substrate-system/wait-on": "^8.0.3",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "auto-changelog": "^2.4.0",
    "browserslist": "^4.28.1",
    "esbuild": "^0.27.0",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "happy-dom": "^20.8.3",
    "htm": "^3.1.1",
    "lightningcss": "^1.30.2",
    "markdown-toc": "^1.2.0",
    "postcss-nesting": "^13.0.2",
    "tap-spec": "^5.0.0",
    "typedoc": "^0.28.9",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "wrangler": "^4.103.0"
  },
  "author": "nichoth <nichoth@nichoth.com> (https://nichoth.com)",
  "license": "SEE LICENSE IN LICENSE"
}
